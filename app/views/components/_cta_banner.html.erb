<%# app/views/components/_cta_banner.html.erb
  locals: label, title, cta_text, cta_path
%>

<div class="relative bg-dark text-cream text-center py-28 px-8 overflow-hidden">
  <%# Subtle background texture %>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(232,225,215,0.16),transparent_55%)] opacity-[0.35]"></div>

  <div class="relative z-10">
    <p class="text-[0.68rem] tracking-[0.3em] uppercase opacity-50 mb-5"><%= label %></p>
    <h2 class="font-serif text-[clamp(1.8rem,4vw,2.8rem)] font-light leading-[1.3] max-w-[600px] mx-auto mb-10">
      <%= title %>
    </h2>
    <%= link_to cta_text, cta_path,
          class: "inline-block border border-cream/60 text-cream text-[0.78rem] font-medium
                  tracking-[0.2em] uppercase px-10 py-[0.9rem] rounded-[2px]
                  transition-colors duration-200 hover:bg-cream hover:text-dark",
          data: (cta_path == rezervovat_path ? { action: "reservation#open" } : {}) %>
  </div>
</div>

<%# app/views/components/_apartment_card.html.erb
  locals: badge, name, desc, image (filename in assets), image_alt
%>

<div class="bg-cream border border-mid/20 overflow-hidden transition-all duration-300
            hover:shadow-[0_12px_40px_rgba(51,51,51,0.10)] hover:-translate-y-1 group js-fade-in">

  <%# Image with zoom on hover %>
  <div class="overflow-hidden">
    <% if local_assigns[:image_url].present? %>
      <%= image_tag image_url,
            alt:   image_alt,
            class: "w-full aspect-[4/3] object-cover block transition-transform duration-500 group-hover:scale-[1.03]",
            loading: "lazy" %>
    <% else %>
      <%= image_tag image,
            alt:   image_alt,
            class: "w-full aspect-[4/3] object-cover block transition-transform duration-500 group-hover:scale-[1.03]",
            loading: "lazy" %>
    <% end %>
  </div>

  <%# Body %>
  <div class="p-8 pb-9">
    <p class="text-[0.65rem] tracking-[0.22em] uppercase text-accent font-medium mb-2"><%= badge %></p>
    <h3 class="font-serif text-[1.55rem] font-normal mb-2"><%= name %></h3>
    <p class="text-[0.88rem] text-mid leading-[1.65] mb-6"><%= desc %></p>
    <%= link_to "Zobrazit detail", cenik_path,
          class: "inline-block border border-dark text-dark text-[0.72rem] font-medium
                  tracking-[0.18em] uppercase px-[1.6rem] py-[0.65rem] rounded-[2px]
                  transition-colors duration-200 hover:bg-dark hover:text-cream" %>
  </div>

</div>

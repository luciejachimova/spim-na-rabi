<%# app/views/pages/_contact_form.html.erb
  Rendered on initial load and re-rendered via Turbo Stream on submit.
  `message` is a Message model instance (or similar form object).
%>

<%= form_with model: message, url: kontakt_path, method: :post,
      id: "contact_form",
      data: { turbo: true } do |f| %>

  <div class="space-y-5">

    <div>
      <%= f.label :name, "Jméno",
            class: "block text-[0.7rem] tracking-[0.16em] uppercase text-mid mb-2" %>
      <%= f.text_field :name,
            placeholder: "Vaše jméno",
            class: "w-full bg-pale border border-mid/20 rounded-[2px] px-4 py-[0.85rem]
                    font-jost text-[0.9rem] text-dark outline-none
                    focus:border-dark transition-colors duration-200",
            required: true %>
    </div>

    <div>
      <%= f.label :email, "Email",
            class: "block text-[0.7rem] tracking-[0.16em] uppercase text-mid mb-2" %>
      <%= f.email_field :email,
            placeholder: "vas@email.cz",
            class: "w-full bg-pale border border-mid/20 rounded-[2px] px-4 py-[0.85rem]
                    font-jost text-[0.9rem] text-dark outline-none
                    focus:border-dark transition-colors duration-200",
            required: true %>
    </div>

    <div>
      <%= f.label :body, "Zpráva",
            class: "block text-[0.7rem] tracking-[0.16em] uppercase text-mid mb-2" %>
      <%= f.text_area :body,
            placeholder: "Napište nám…",
            rows: 6,
            class: "w-full bg-pale border border-mid/20 rounded-[2px] px-4 py-[0.85rem]
                    font-jost text-[0.9rem] text-dark outline-none resize-y
                    focus:border-dark transition-colors duration-200" %>
    </div>

    <%= f.submit "Odeslat zprávu",
          class: "bg-dark text-cream text-[0.78rem] font-medium tracking-[0.18em] uppercase
                  px-10 py-[0.9rem] rounded-[2px] border-none cursor-pointer
                  transition-all duration-200 hover:bg-accent hover:-translate-y-0.5" %>

  </div>

<% end %>

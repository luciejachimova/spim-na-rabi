<%# app/views/pages/kontakt.html.erb %>
<% content_for :title, "Kontakt — Spím na Rabí" %>

<%= render "components/page_hero", label: "Jsme tu pro vás", title: "Kontakt" %>

<section class="py-24 md:py-[100px]">
  <div class="max-w-[1100px] mx-auto px-8">

    <div class="grid grid-cols-1 md:grid-cols-2 gap-20">

      <%# Contact info + map %>
      <div class="js-fade-in space-y-8">

        <div>
          <p class="text-[0.65rem] tracking-[0.22em] uppercase text-mid mb-1">Email</p>
          <p class="font-serif text-xl text-dark">
            <%= mail_to "info@spimnarabi.cz", "info@spimnarabi.cz", class: "hover:text-accent transition-colors" %>
          </p>
        </div>

        <div>
          <p class="text-[0.65rem] tracking-[0.22em] uppercase text-mid mb-1">Telefon</p>
          <p class="font-serif text-xl text-dark">
            <%= link_to "+420 723 936 426", "tel:+420723936426", class: "hover:text-accent transition-colors" %>
          </p>
        </div>

        <div>
          <p class="text-[0.65rem] tracking-[0.22em] uppercase text-mid mb-1">Adresa</p>
          <p class="font-serif text-xl text-dark leading-snug">Rabí 175<br>342 01 Rabí</p>
        </div>

        <%= render "components/map_embed" %>

      </div>

      <%# Contact form — Turbo Stream for inline success message %>
      <div class="js-fade-in" id="contact-form-wrapper">
        <%= render "contact_form", message: @message %>
      </div>

    </div>
  </div>
</section>

<%# app/views/pages/galerie.html.erb %>
<% content_for :title, "Galerie — Spím na Rabí" %>

<%= render "components/page_hero",
           label: "Podívejte se",
           title: "Galerie" %>

<section class="py-24 md:py-[100px]">
  <div class="max-w-[1100px] mx-auto px-8">

    <%#
      Masonry grid via CSS columns.
      Images come from @images assigned in PagesController#galerie.
      Each image: { src:, alt: }

      Lightbox is triggered by Stimulus
      lightbox_controller via data-action.
    %>

    <div
      class="columns-1 sm:columns-2 lg:columns-3 gap-5 js-fade-in"
      data-controller="lightbox"
    >
      <% @images.each_with_index do |image, index| %>
        <div class="break-inside-avoid mb-5 overflow-hidden cursor-pointer group">
          <%= image_tag image[:src],
                        alt: image[:alt],
                        loading: "lazy",
                        class: "w-full block transition-transform duration-500 group-hover:scale-[1.03]",
                        data: {
                          action: "click->lightbox#open",
                          src: image[:src],
                          index: index
                        } %>
        </div>
      <% end %>
    </div>

  </div>
</section>
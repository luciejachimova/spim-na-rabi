<%# app/views/pages/home.html.erb %>
<% content_for :title, "Spim na Rabí — Ubytování u hradu Rabí" %>

<%# ═══ HERO ═══ %>
<section
  id="hero"
  class="relative h-screen min-h-[600px] flex items-center justify-center overflow-hidden bg-cream border-b border-mid/10"
>
  <%# Design background %>
  <div class="absolute inset-0 bg-[linear-gradient(to_bottom,#E8E1D7_0%,#F7F5F2_100%)]"></div>
  <%= image_tag "hero-rabi-lineart.png",
        alt: "",
        aria: { hidden: true },
        class: "pointer-events-none absolute bottom-20 left-1/2 w-[1100px] max-w-[92vw] -translate-x-1/2 opacity-[0.09]" %>

  <%# Content %>
  <div class="relative z-10 text-center text-dark px-8">
    <p class="text-[0.75rem] tracking-[0.3em] uppercase text-mid mb-5 font-jost font-normal animate-fade-up [animation-delay:300ms]">
      Ubytování v srdci Šumavy
    </p>
    <h1 class="font-script text-[clamp(3rem,8vw,6rem)] leading-[1.05] mb-4 animate-fade-up [animation-delay:550ms]">
      Spim na Rabí
    </h1>
    <p class="font-serif text-[clamp(1.1rem,2.5vw,1.45rem)] italic font-light text-mid mb-11 animate-fade-up [animation-delay:750ms]">
      Ubytování, kde se čas zpomalí
    </p>
    <%= link_to "Rezervovat pobyt", rezervovat_path,
          class: "inline-block bg-dark text-cream text-[0.78rem] font-medium tracking-[0.2em] uppercase
                  px-10 py-[0.9rem] rounded-[2px] transition-all duration-300
                  hover:bg-accent hover:-translate-y-0.5
                  animate-fade-up [animation-delay:950ms]",
          data: { action: "reservation#open" } %>
  </div>

  <%# Scroll indicator %>
  <div class="absolute bottom-9 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1 opacity-55 animate-fade-up [animation-delay:1300ms]">
    <span class="text-[0.65rem] tracking-[0.22em] uppercase text-mid">Scroll</span>
    <div class="w-px h-11 bg-mid/40 animate-scroll-pulse"></div>
  </div>
</section>

<%# ═══ INTRO STRIP ═══ %>
<div class="bg-dark text-cream text-center py-14 px-8 js-fade-in">
  <p class="font-serif text-[clamp(1.1rem,2.2vw,1.35rem)] italic font-light max-w-[680px] mx-auto leading-[1.75] opacity-90">
    Hrad Rabí na dosah, klid šumavské přírody a vzduch, který zpomalí každou myšlenku. Objevte místo, kde rána začínají tichem a večery mají své kouzlo
  </p>
</div>

<%# ═══ APARTMÁNY ═══ %>
<section id="apartmany" class="bg-pale py-24 md:py-[100px]">
  <div class="max-w-[1100px] mx-auto px-8">
    <div class="js-fade-in">
      <%= render "components/section_header",
            label: "Ubytování",
            title: "Naše apartmány",
            body:  "Dva pečlivě zařízené prostory, každý s vlastním charakterem. Oba s výhledem, klidem a vším, co k odpočinku potřebujete.",
            align: :left %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mt-16">
      <%= render "components/apartment_card",
            badge:    "Apartmán 1",
            name:     "Apartmán 1",
            desc:     "Útulný apartmán pro klidný pobyt. Ideální pro páry nebo jednotlivce, kteří hledají jednoduchost, klid a pohodlí. Menší prostor, který má vše, co potřebujete k odpočinku.",
            image_url: "https://images.unsplash.com/photo-1595526114035-0d45ed16cfbf?auto=format&fit=crop&w=1000&q=80",
            image_alt: "Apartmán 1" %>

      <%= render "components/apartment_card",
            badge:    "Apartmán 2",
            name:     "Apartmán 2",
            desc:     "Prostorný apartmánový loft. Vzdušný apartmán s dostatkem prostoru pro rodinu nebo delší pobyt. Kombinace pohodlí a dostatku místa.",
            image_url: "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1000&q=80",
            image_alt: "Apartmán 2" %>
    </div>
  </div>
</section>

<%# ═══ RECENZE ═══ %>
<section id="recenze" class="py-24 md:py-[100px]">
  <div class="max-w-[1100px] mx-auto px-8">
    <div class="js-fade-in">
      <%= render "components/section_header",
            label: "Hosté říkají",
            title: "Recenze",
            align: :center %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
      <%= render "components/review_card", text: "Krásné místo, naprostý klid a nádherný výhled. Určitě se vrátíme.", author: "Jana & Tomáš" %>
      <%= render "components/review_card", text: "Stylové ubytování, všechno perfektně připravené. Nic nám nechybělo.", author: "Markéta K." %>
      <%= render "components/review_card", text: "Ideální únik z města. Ticho, příroda, pohoda. Přesně to, co jsme potřebovali.", author: "Rodina Novákova" %>
    </div>
  </div>
</section>

<%# ═══ LOKALITA ═══ %>
<section id="lokalita" class="bg-pale py-24 md:py-[100px]">
  <div class="max-w-[1100px] mx-auto px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-20 items-start">

      <div class="js-fade-in">
        <%= render "components/section_header",
              label: "Kde nás najdete",
              title: "Rabí",
              body:  "Malebné mšsto na okraji Šumavy, kde se historie potkává s klidem přírody. Dominantou místa je majestátní hrad Rabí — největší hradní zřícenina v Čechách — jen pár minut od vašeho pobytu. Perfektní pro odpočinek i výlety po okolí.",
              align: :left %>

        <div class="mt-6 text-sm text-mid">
          <strong class="text-dark font-medium block mb-0.5">Adresa</strong>
          Rabí 175, 342 01 Rabí
        </div>
        <div class="mt-6">
          <%= link_to "Napsat nám", kontakt_path,
                class: "inline-block border border-dark text-dark text-[0.72rem] font-medium
                        tracking-[0.18em] uppercase px-[1.6rem] py-[0.65rem] rounded-[2px]
                        transition-colors duration-200 hover:bg-dark hover:text-cream" %>
        </div>
      </div>

      <div class="js-fade-in">
        <%= render "components/map_embed" %>
      </div>

    </div>
  </div>
</section>

<%# ═══ CTA BANNER ═══ %>
<section id="rezervace">
  <%= render "components/cta_banner",
        label:   "Připraveni zpomalit?",
        title:   "Rezervujte si pobyt a dopřejte si odpočinek pod hradem Rabí.",
        cta_text: "Rezervace",
        cta_path: rezervovat_path %>
</section>

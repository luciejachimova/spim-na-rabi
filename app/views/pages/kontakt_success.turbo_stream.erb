<%# app/views/pages/kontakt_success.turbo_stream.erb
  Returned by MessagesController#create on success.
  Replaces the form wrapper with a thank-you message — no page reload needed.
%>

<%= turbo_stream.replace "contact-form-wrapper" do %>
  <div class="py-12 text-center js-fade-in">
    <div class="w-10 h-px bg-light mx-auto mb-8"></div>
    <p class="font-serif text-[1.5rem] font-normal text-dark mb-3">Zpráva odeslána</p>
    <p class="text-mid text-sm leading-relaxed">
      Děkujeme! Brzy se vám ozveme na váš email.
    </p>
    <div class="w-10 h-px bg-light mx-auto mt-8"></div>
  </div>
<% end %>

<%# app/views/shared/_footer.html.erb %>

<footer class="bg-cream border-t border-mid/15 pt-16 pb-10">
  <div class="max-w-[1100px] mx-auto px-8">

    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr_1fr] gap-10">

      <%# Brand column %>
      <div>
        <span class="font-script text-[1.4rem] text-dark block mb-2">Spím na Rabí</span>
        <p class="text-mid text-sm leading-relaxed max-w-[220px]">
          Ubytování pod hradem Rabí. Klid, příroda, pohodlí.
        </p>
        <div class="flex gap-3 mt-5">
          <%= link_to "f", "#", title: "Facebook",
                class: "flex items-center justify-center w-9 h-9 border border-light rounded-[2px]
                        text-mid text-sm font-medium transition-colors duration-200
                        hover:border-dark hover:text-dark" %>
          <%= link_to "in", "#", title: "Instagram",
                class: "flex items-center justify-center w-9 h-9 border border-light rounded-[2px]
                        text-mid text-sm font-medium transition-colors duration-200
                        hover:border-dark hover:text-dark" %>
        </div>
      </div>

      <%# Stránky %>
      <div>
        <h4 class="text-[0.68rem] tracking-[0.22em] uppercase text-dark font-medium mb-4">Stránky</h4>
        <ul class="space-y-2 list-none">
          <li><%= link_to "Hlavní stránka", root_path,    class: footer_link_class %></li>
          <li><%= link_to "O nás",          o_nas_path,   class: footer_link_class %></li>
          <li><%= link_to "Galerie",        galerie_path, class: footer_link_class %></li>
          <li><%= link_to "Ceník",          cenik_path,   class: footer_link_class %></li>
          <li><%= link_to "Kontakt",        kontakt_path, class: footer_link_class %></li>
        </ul>
      </div>

      <%# Ubytování %>
      <div>
        <h4 class="text-[0.68rem] tracking-[0.22em] uppercase text-dark font-medium mb-4">Ubytování</h4>
        <ul class="space-y-2 list-none">
          <li><%= link_to "Apartmán 1", cenik_path, class: footer_link_class %></li>
          <li><%= link_to "Apartmán 2",  cenik_path, class: footer_link_class %></li>
          <li><%= link_to "Ceník",                       cenik_path, class: footer_link_class %></li>
        </ul>
      </div>

      <%# Kontakt %>
      <div>
        <h4 class="text-[0.68rem] tracking-[0.22em] uppercase text-dark font-medium mb-4">Kontakt</h4>
        <ul class="space-y-2 list-none">
          <li><%= link_to "info@spimnarabi.cz", "mailto:info@spimnarabi.cz", class: footer_link_class %></li>
          <li><%= link_to "+420 777 000 111",   "tel:+420777000111",         class: footer_link_class %></li>
          <li><span class="text-mid text-sm">Rabí 175, 342 01</span></li>
        </ul>
      </div>

    </div>

    <div class="mt-14 pt-6 border-t border-mid/10 text-center text-[0.75rem] text-light tracking-wide">
      © <%= Time.current.year %> Spím na Rabí - Rabí, Šumava
    </div>

  </div>
</footer>

<%= form_with model: reservation,
              url: reservations_path,
              id: "reservation_form",
              method: :post,
              data: { turbo: true },
              class: "space-y-5" do |f| %>
  <% if reservation.errors.any? %>
    <div class="border border-accent/30 bg-pale p-4 text-sm leading-relaxed text-dark">
      Zkontrolujte prosím povinná pole.
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    <div>
      <%= f.label :name, "Jméno", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
      <%= f.text_field :name,
            placeholder: "Vaše jméno",
            required: true,
            class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
    </div>

    <div>
      <%= f.label :email, "Email", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
      <%= f.email_field :email,
            placeholder: "vas@email.cz",
            required: true,
            class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
    </div>

    <div>
      <%= f.label :phone, "Telefon", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
      <%= f.telephone_field :phone,
            placeholder: "+420",
            class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
    </div>

    <div>
      <%= f.label :apartment, "Apartmán", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
      <%= f.select :apartment,
            [["Vyberte apartmán", ""], ["Apartmán 1 - Studio ³", "Apartmán 1 - Studio ³"], ["Apartmán 2 - Loft ¹⁰", "Apartmán 2 - Loft ¹⁰"], ["Je mi to jedno", "Je mi to jedno"]],
            {},
            class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
    </div>

    <div>
      <%= f.label :date_from, "Příjezd", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
      <%= f.date_field :date_from,
            required: true,
            class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
    </div>

    <div>
      <%= f.label :date_to, "Odjezd", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
      <%= f.date_field :date_to,
            required: true,
            class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
    </div>
  </div>

  <div>
    <%= f.label :guests, "Počet hostů", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
    <%= f.number_field :guests,
          min: 1,
          required: true,
          placeholder: "2",
          class: "w-full rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
  </div>

  <div>
    <%= f.label :note, "Poznámka", class: "mb-2 block text-[0.7rem] uppercase tracking-[0.16em] text-mid" %>
    <%= f.text_area :note,
          rows: 4,
          placeholder: "Napište nám termín, přání nebo dotaz…",
          class: "w-full resize-y rounded-[2px] border border-mid/20 bg-pale px-4 py-[0.85rem] font-jost text-[0.9rem] text-dark outline-none transition-colors duration-200 focus:border-dark" %>
  </div>

  <%= f.submit "Odeslat rezervaci",
        class: "cursor-pointer rounded-[2px] border-none bg-dark px-10 py-[0.9rem] text-[0.78rem] font-medium uppercase tracking-[0.18em] text-cream transition-all duration-200 hover:-translate-y-0.5 hover:bg-accent" %>
<% end %>

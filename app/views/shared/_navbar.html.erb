<%# app/views/shared/_navbar.html.erb
  Sticky navigation with Hotwire Turbo Drive links.
  Stimulus controller handles: scroll shadow + mobile menu toggle.
%>

<nav
  class="fixed top-0 inset-x-0 z-50 bg-cream border-b border-mid/10 transition-shadow duration-300"
  data-controller="navbar"
  data-navbar-scrolled-class="shadow-[0_2px_24px_rgba(51,51,51,0.07)]"
>
  <div class="max-w-[1100px] mx-auto px-8 h-[68px] flex items-center justify-between">

    <%# Brand %>
    <%= link_to image_tag(
          "spim-na-rabi-logo.png",
          alt: "Spím na Rabí",
          class: "h-12 w-auto max-w-[150px] object-contain md:h-14 md:max-w-[180px]"
        ), root_path, class: "block shrink-0", aria: { label: "Spím na Rabí" } %>

    <%# Desktop links %>
    <ul
      class="hidden md:flex items-center gap-8 list-none
             max-md:flex max-md:flex-col max-md:fixed max-md:inset-0 max-md:top-[68px]
             max-md:bg-cream max-md:justify-center max-md:gap-10 max-md:z-40
             max-md:hidden"
      id="nav-menu"
      data-navbar-target="menu"
    >
      <li><%= link_to "Hlavní stránka", root_path,        class: nav_link_class(request, root_path) %></li>
      <li><%= link_to "O nás",          o_nas_path,       class: nav_link_class(request, o_nas_path) %></li>
      <li><%= link_to "Galerie",        galerie_path,     class: nav_link_class(request, galerie_path) %></li>
      <li><%= link_to "Kontakt",        kontakt_path,     class: nav_link_class(request, kontakt_path) %></li>
      <li>
        <%= link_to "Rezervovat", rezervovat_path,
              class: "bg-dark text-cream text-[0.78rem] font-medium tracking-[0.16em] uppercase
                      px-[1.4rem] py-2 rounded-[2px] transition-colors duration-200
                      hover:bg-accent",
              data: { action: "reservation#open" } %>
      </li>
    </ul>

    <%# Hamburger - mobile only %>
    <button
      class="flex md:hidden flex-col gap-[5px] p-1 cursor-pointer"
      data-action="click->navbar#toggleMenu"
      aria-label="Otevřít menu"
      aria-expanded="false"
      data-navbar-target="button"
    >
      <span class="block w-[22px] h-[1.5px] bg-dark transition-all duration-300" data-navbar-target="bar1"></span>
      <span class="block w-[22px] h-[1.5px] bg-dark transition-all duration-300" data-navbar-target="bar2"></span>
      <span class="block w-[22px] h-[1.5px] bg-dark transition-all duration-300" data-navbar-target="bar3"></span>
    </button>

  </div>
</nav>

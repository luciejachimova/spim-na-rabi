<div
  id="reservation-modal"
  class="fixed inset-0 z-[180] hidden items-center justify-center bg-dark/70 px-4 py-8"
  data-reservation-target="modal"
  data-action="click->reservation#closeOnBackdrop keydown.esc@window->reservation#close"
  aria-hidden="true"
>
  <div class="relative max-h-[92vh] w-full max-w-[720px] overflow-y-auto bg-cream p-7 shadow-[0_24px_80px_rgba(51,51,51,0.24)] md:p-10">
    <button
      type="button"
      class="absolute right-5 top-4 text-3xl font-light leading-none text-mid transition-colors hover:text-dark"
      aria-label="Zavřít rezervaci"
      data-action="reservation#close"
    >×</button>

    <div class="mb-8 pr-8">
      <p class="mb-2 text-[0.68rem] font-normal uppercase tracking-[0.3em] text-mid">Rezervace</p>
      <h2 class="font-serif text-[clamp(2rem,4vw,2.8rem)] font-normal leading-[1.2] text-dark">
        Poptejte svůj pobyt
      </h2>
      <div class="mt-5 h-px w-10 bg-light"></div>
    </div>

    <%= render "shared/reservation_form", reservation: reservation %>
  </div>
</div>

# Seznam Email SMTP
SMTP_HOST=smtp.seznam.cz
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=spimnarabi@seznam.cz
SMTP_PASS=heslo-nebo-heslo-pro-aplikaci
SMTP_FROM=spimnarabi@seznam.cz
CONTACT_INBOX=spimnarabi@seznam.cz
PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="file:./storage/development.sqlite3"
CRON_SECRET=nejake-dlouhe-tajne-heslo

# Admin panel
ADMIN_PASSWORD=nejake-silne-heslo
ADMIN_SESSION_SECRET=nejaky-dlouhy-nahodny-retezec

# Produkce na Vercelu: souborová SQLite databáze (DATABASE_URL výše) tam
# nefunguje (funkce běží na efemérním, needitovatelném disku). Nastavte tyto
# proměnné (jen na Vercelu, lokálně je nechte prázdné) na Turso databázi —
# viz README.md, sekce "Nasazení na Vercel".
#
# LOKÁLNĚ JE NECHTE ZAKOMENTOVANÉ. Aplikace se ke vzdálené databázi mimo
# Vercel odmítne připojit, dokud nedostane DB_ALLOW_REMOTE=1 (viz níže) —
# jinak by jeden zapomenutý řádek v .env znamenal, že `prisma migrate` nebo
# seed z laptopu píše do produkce.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# Povolení vzdálené databáze mimo Vercel. Nastavujte jen tam, kde to má být:
#  • samohostovaný deploy (Docker/VPS) proti Turso: DB_ALLOW_REMOTE=1
#  • vlastní VÝVOJOVÁ Turso databáze (ne produkční): DB_ALLOW_REMOTE=1
#  • jednorázový záměrný zásah do produkce: uveďte na začátku příkazu,
#    např. `DB_ALLOW_REMOTE=1 npx tsx prisma/seed.ts`
# Na Vercelu tuto proměnnou nastavovat nemusíte (platforma nastavuje VERCEL=1).
# DB_ALLOW_REMOTE=1

# Místo SMTP_HOST/SMTP_USER/SMTP_PASS lze použít také původní Rails názvy:
# SMTP_ADDRESS=smtp.example.com
# SMTP_USER_NAME=odesilaci-email@example.com
# SMTP_PASSWORD=heslo-nebo-app-password

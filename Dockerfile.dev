# syntax=docker/dockerfile:1
# check=error=true

# Development Dockerfile. The root Dockerfile is production-only.
# Used by docker-compose.yml for local development.

FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev"]
